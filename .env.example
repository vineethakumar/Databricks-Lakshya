# Copy to .env and adjust as needed.

# --- Oracle container (docker-compose.yml) ---
ORACLE_SYSTEM_PASSWORD=SysPassword123
ORACLE_APP_USER=telecom_qoe
ORACLE_APP_PASSWORD=AppPassword123

# --- Python pipeline connection (src/config.py; also used by
# scripts/oracle_db.py + scripts/load_csv_to_oracle.py) ---
DB_USER=telecom_qoe
DB_PASSWORD=AppPassword123
# Local docker-compose Oracle container:
DB_DSN=localhost:1521/FREEPDB1
# Remote/Oracle Cloud instance, plain TCP:
#   DB_DSN=host:port/service_name
# Oracle Cloud Autonomous DB, one-way TLS (no wallet), matching the "TLS"
# tab (not "Mutual TLS") in the ADB console's Database Connection panel:
#   DB_DSN=tcps://host:port/service_name?ssl_server_dn_match=true

# --- Databricks SQL Warehouse (scripts/test_databricks_connection.py) ---
# Find the first two under your SQL Warehouse's "Connection details" tab;
# generate a token under User Settings -> Developer -> Access tokens.
DATABRICKS_SERVER_HOSTNAME=adb-1234567890123456.7.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/abcdef1234567890
DATABRICKS_TOKEN=dapi_your_token_here
