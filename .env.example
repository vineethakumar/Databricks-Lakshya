# Copy to .env and adjust as needed.

# --- Databricks connection (src/config.py; used by src/db.py, read by
# backend/app.py at startup). Find server hostname + HTTP path under your
# SQL Warehouse's "Connection details" tab. Generate a token under
# User Settings -> Developer -> Access tokens. ---
DATABRICKS_SERVER_HOSTNAME=xxxxxxxxxxxxxxxx.gcp.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DATABRICKS_CATALOG=telecom_qoe_catalog
DATABRICKS_SCHEMA=telecom_qoe

# --- Oracle connection (src/config.py; used by scripts/oracle_db.py) ---
# Kept for backward compatibility / reverting to Oracle if ever needed.
DB_USER=telecom_qoe
DB_PASSWORD=AppPassword123
# Plain TCP, e.g. a remote VM/on-prem Oracle instance:
DB_DSN=host:port/service_name
# Oracle Cloud Autonomous DB, one-way TLS (no wallet), matching the "TLS"
# tab (not "Mutual TLS") in the ADB console's Database Connection panel:
#   DB_DSN=tcps://host:port/service_name?ssl_server_dn_match=true

# --- SQLite output store (src/predictions_store.py) ---
# Path is relative to the project root unless absolute.
SQLITE_DB_PATH=predictions.db
